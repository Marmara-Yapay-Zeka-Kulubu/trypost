# Marmara AI fork: club portal, default language and guest branding
# (app/Marmara/README.md, "Portal"). Add to the VM's .env
# (/opt/trypost-marmara/.env on stage, /opt/trypost-marmara-prod/.env on
# production), then recreate the app container so the config is re-read.

# Guests (login, register, password reset) and sign-ups that never touched the
# language picker get Turkish. A signed-in user's own language always wins.
# APP_LOCALE=en is upstream behaviour. Keep the fallback on en.
# (MARMARA_DEFAULT_LOCALE=tr does the same for the panel only, if APP_LOCALE must stay en.)
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en

# Club header on the guest screens. false = upstream TryPost look.
MARMARA_BRANDING=true
# MARMARA_BRAND_NAME="Marmara Yapay Zeka Kulübü"
# MARMARA_BRAND_TAGLINE="Sosyal Medya Paneli"

# Logo: a URL or a path under public/. Empty = public/marmara/logo.{svg,png,webp}
# if that file is in the image, otherwise a text wordmark.
# MARMARA_BRAND_LOGO=
# MARMARA_BRAND_LOGO_DARK=

# Accent for buttons and links on the auth screens (#rrggbb, dark enough for
# white text). Unset = #1e6bf5 (the logo blue, darkened for contrast);
# set it empty to keep TryPost's own colours.
# MARMARA_BRAND_ACCENT=#1e6bf5

# Optional "Source code" link next to the TryPost credit (AGPL-3.0 section 13).
# MARMARA_SOURCE_URL=https://github.com/MepCity/trypost
