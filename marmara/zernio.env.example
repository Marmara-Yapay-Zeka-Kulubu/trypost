# Marmara AI fork: TikTok publishing through Zernio (app/Marmara/README.md).
# Add to the VM's .env (/opt/trypost-marmara/.env on stage,
# /opt/trypost-marmara-prod/.env on production). Never commit the real key.

# Off by default: TikTok then publishes natively, exactly like upstream TryPost.
ZERNIO_ENABLED=false

# https://zernio.com/dashboard/api-keys (starts with sk_)
ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://zernio.com/api/v1

# Which TryPost TikTok channel publishes through which Zernio account.
# ZERNIO_TIKTOK_ACCOUNT_ID: the "Zernio id" from `php artisan marmara:zernio:accounts`.
# ZERNIO_TIKTOK_TRYPOST_ACCOUNT: the TikTok username in TryPost (or the channel id).
ZERNIO_TIKTOK_ACCOUNT_ID=
ZERNIO_TIKTOK_TRYPOST_ACCOUNT=
# More than one: ZERNIO_TIKTOK_ACCOUNTS="username1=zernioId1,username2=zernioId2"
# ZERNIO_TIKTOK_ACCOUNTS=

# upload: copy media to Zernio's storage first; url: let Zernio fetch TryPost's public media URL.
# ZERNIO_MEDIA_MODE=upload
# ZERNIO_STATUS_POLL_SECONDS=60
# ZERNIO_STATUS_WINDOW_MINUTES=180
# ZERNIO_TIMEOUT=120
