# Marmara AI fork: "Tasarımlar" design gallery (app/Marmara/README.md, "Designs").
# Add to the VM's .env (/opt/trypost-marmara/.env on stage,
# /opt/trypost-marmara-prod/.env on production) and recreate the app container.
# With MARMARA_DESIGNS_ENABLED=false TryPost behaves exactly as without the
# module (no page, sync, API, MCP tools or webhooks).

MARMARA_DESIGNS_ENABLED=true

# The TryPost workspace the designs belong to (Settings > Workspace, or
# `php artisan tinker` -> Workspace::pluck('id', 'name')). May stay empty
# while the install has exactly one workspace.
MARMARA_DESIGNS_WORKSPACE_ID=

# The shared folder: the id at the end of
# https://drive.google.com/drive/folders/<FOLDER_ID>
MARMARA_DESIGNS_FOLDER_ID=

# The service account's JSON key, mounted read-only into the app container
# (never committed; see the README for the compose volume line).
MARMARA_DESIGNS_SA_KEY=/run/secrets/marmara-designs-sa.json

# Optional "Drive'a yükleme izni" (uploads from TryPost into the lead's Drive).
# OAuth client of type "Web application" in the same Google Cloud project.
# Authorized redirect URI: {APP_URL}/designs/drive/callback
MARMARA_DESIGNS_OAUTH_CLIENT_ID=
MARMARA_DESIGNS_OAUTH_CLIENT_SECRET=
# Empty = {APP_URL}/designs/drive/callback
MARMARA_DESIGNS_OAUTH_REDIRECT=
# Google Picker (the one-time "Klasöre erişim ver" step): an API key
# restricted to the Picker API and the site, and the project NUMBER.
MARMARA_DESIGNS_PICKER_API_KEY=
MARMARA_DESIGNS_PICKER_APP_ID=

# Thumbnail cache on the local disk (LRU, evicted to 90 % of this).
MARMARA_DESIGNS_THUMBNAIL_CACHE_MB=500
# MARMARA_DESIGNS_THUMBNAIL_PATH=/var/www/html/storage/app/marmara-designs/thumbnails
# MARMARA_DESIGNS_THUMBNAIL_QUALITY=70
# MARMARA_DESIGNS_SIGNED_URL_DAYS=7
# MARMARA_DESIGNS_THUMBNAIL_SOURCE_MAX_MB=40

# Mark every Drive revision keepForever=true (needs Editor on the folder).
MARMARA_DESIGNS_KEEP_REVISIONS=true

# No design.added webhook for files older than this (first sync never notifies).
MARMARA_DESIGNS_NOTIFY_MAX_AGE_HOURS=24
# MARMARA_DESIGNS_MAX_CHANGE_PAGES=20
# MARMARA_DESIGNS_UPLOAD_MAX_MB=100

# A published post's images and videos that did not come from the gallery are
# added to it (needs the Drive upload permission), into "<folder>/<YYYY-MM>".
# MARMARA_DESIGNS_AUTO_ADD=true
# MARMARA_DESIGNS_AUTO_ADD_FOLDER=Paylaşılanlar
