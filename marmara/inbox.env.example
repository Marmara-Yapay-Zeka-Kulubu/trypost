# Marmara AI fork: comments and DMs inbox (app/Marmara/README.md, "Inbox").
# Add to the VM's .env (/opt/trypost-marmara/.env on stage,
# /opt/trypost-marmara-prod/.env on production) and recreate the app container.
# Every switch is off by default: with MARMARA_INBOX_ENABLED=false TryPost
# behaves exactly as without the module (no page, API, MCP tools or scopes).

MARMARA_INBOX_ENABLED=true

# One switch per provider. Turn on only what is ready (see the checklist in
# app/Marmara/README.md). A provider that lacks a permission shows
# "needs permission X" on the inbox page and in marmara:inbox:status.
MARMARA_INBOX_LINKEDIN=true
MARMARA_INBOX_INSTAGRAM=false
MARMARA_INBOX_FACEBOOK=false
# Zernio's inbox (TikTok, and any channel in MARMARA_INBOX_ZERNIO_ACCOUNTS).
# A legacy Zernio plan answers INBOX_REQUIRED; sent DMs count toward Zernio's
# outbound messages (10,000 free a month).
MARMARA_INBOX_ZERNIO=false
# X mentions/DMs through TryPost's own X connection: needs an X API plan that
# can read (pay-per-use credits). Off unless the club pays for X reads.
MARMARA_INBOX_X=false

# Extra scopes TryPost's connect asks for while the provider is on (then
# "Refresh connection" on each card). Trim a list while Meta has not granted
# the permission yet, e.g. drop instagram_business_manage_messages.
# MARMARA_INBOX_INSTAGRAM_SCOPES="instagram_business_manage_comments,instagram_business_manage_messages"
# MARMARA_INBOX_INSTAGRAM_FACEBOOK_SCOPES="instagram_manage_comments,instagram_manage_messages,pages_manage_metadata"
# MARMARA_INBOX_FACEBOOK_SCOPES="pages_read_user_content,pages_manage_engagement,pages_messaging"
# MARMARA_INBOX_X_SCOPES="dm.read,dm.write"

# A new item older than this is stored without the inbox.item_received
# webhook (the first sync of a channel reads its backlog silently).
MARMARA_INBOX_NOTIFY_MAX_AGE_HOURS=24
# Posts younger than this are polled for comments.
MARMARA_INBOX_POST_WINDOW_DAYS=14
MARMARA_INBOX_MAX_PAGES_PER_SYNC=3

# LinkedIn: taken from MARMARA_LINKEDIN_DAILY_CALL_BUDGET (80), never added to it.
# 3 posts every 3 hours = about 26 calls a day.
MARMARA_INBOX_LINKEDIN_DAILY_CALLS=30
MARMARA_INBOX_LINKEDIN_INTERVAL_MINUTES=180
MARMARA_INBOX_LINKEDIN_POSTS_PER_RUN=3

# Instagram and Facebook (polling; Meta webhooks need Live mode + Advanced Access).
MARMARA_INBOX_META_INTERVAL_MINUTES=10
MARMARA_INBOX_META_POSTS_PER_RUN=5
MARMARA_INBOX_META_BACKOFF_MINUTES=30

# Zernio (uses ZERNIO_API_KEY / ZERNIO_BASE_URL from marmara/zernio.env.example).
MARMARA_INBOX_ZERNIO_INTERVAL_MINUTES=10
MARMARA_INBOX_ZERNIO_POSTS_PER_RUN=5
# Channels whose inbox comes from Zernio even when a native provider could
# read them: platform:trypostAccount=zernioAccountId (account = TryPost id,
# username or platform user id). TikTok entries of ZERNIO_ACCOUNTS are used
# without being repeated here.
MARMARA_INBOX_ZERNIO_ACCOUNTS=
# Optional real-time receiver: {APP_URL}/api/marmara/zernio/inbox-webhook
# (events comment.received, message.received). Empty = polling only.
MARMARA_INBOX_ZERNIO_WEBHOOK_SECRET=

MARMARA_INBOX_X_INTERVAL_MINUTES=30
