# Marmara AI fork: native LinkedIn page analytics (app/Marmara/README.md, "LinkedIn").
# Add to the VM's .env (/opt/trypost-marmara/.env on stage,
# /opt/trypost-marmara-prod/.env on production). Never commit the real secret.

# TryPost's own LinkedIn app ("Marmara AI Sosyal", Community Management API).
# Redirect URL registered in the LinkedIn app: {APP_URL}/accounts/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CLIENT_REDIRECT="${APP_URL}/accounts/linkedin/callback"
# Scopes asked when a page is connected. openid/profile/email need the app's
# "Sign In with LinkedIn using OpenID Connect" product; w_member_social is only
# needed for personal profiles (LINKEDIN_ENABLED=false turns those off).
LINKEDIN_PAGE_SCOPES="openid,profile,email,w_organization_social,r_organization_social,rw_organization_admin,r_organization_followers,r_organization_social_feed"
# LINKEDIN_ENABLED=false

# Off by default: LinkedIn pages then keep Zernio (or upstream behaviour).
# On: a LinkedIn page connected natively and NOT in ZERNIO_ACCOUNTS is measured
# through LinkedIn's API; a page still in ZERNIO_ACCOUNTS stays with Zernio.
MARMARA_LINKEDIN_NATIVE_ANALYTICS=false

# LinkedIn-Version header (YYYYMM, supported for about a year).
# MARMARA_LINKEDIN_API_VERSION=202610
# MARMARA_LINKEDIN_TIMEOUT=20
# MARMARA_LINKEDIN_CONNECT_TIMEOUT=5

# Calls per UTC day for all of this module's reads (Development tier: ~500/app, ~100/member).
# MARMARA_LINKEDIN_DAILY_CALL_BUDGET=80
# Calls the backfill command leaves for the scheduled reads.
# MARMARA_LINKEDIN_BACKFILL_RESERVE=20
# MARMARA_LINKEDIN_BACKOFF_MINUTES=60
# MARMARA_LINKEDIN_STATS_BATCH_SIZE=50
# MARMARA_LINKEDIN_CACHE_MINUTES=720
# MARMARA_LINKEDIN_PAGE_SIZE=50
# MARMARA_LINKEDIN_DISCOVERY_INTERVAL_HOURS=12
# MARMARA_LINKEDIN_VIDEO_VIEWS_MAX_AGE_DAYS=180
# MARMARA_LINKEDIN_IMPORT_LIMIT=500
